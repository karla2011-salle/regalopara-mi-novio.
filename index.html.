<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    background-color: #0a0a0a;
    color: #ffffff;
    font-family: 'Courier New', monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
  }
  .terminal {
    background: #1a1a1a;
    border: 1px solid #00ff41;
    border-radius: 8px;
    padding: 20px;
    width: 90%;
    max-width: 600px;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
  }
  h1 { color: #00ff41; font-size: 1.5rem; }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 20px;
  }
  .photo-grid img {
    width: 100%;
    border-radius: 5px;
    border: 1px solid #333;
  }
</style>
</head>
<body>
  <h1>> ¡Feliz Cumpleaños! _</h1>
  <div class="terminal">
    <p style="color: #6a9955;">// Eres mi jugador favorito</p>
    <p>if (amor == "infinito") {</p>
    <p>&nbsp;&nbsp;console.log("¡Te amo muchísimo!");</p>
    <p>}</p>
  </div>
  <div class="photo-grid">
    <img src="foto1.jpg">
    <img src="foto2.jpg">
  </div>
</body>
</html>
